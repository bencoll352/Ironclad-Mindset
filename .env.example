# IRONCLAD MINDSET — ENVIRONMENT VARIABLES
# Copy to .env.local for local development.

# 1. Gemini API key — SERVER-SIDE ONLY.
# Set it as a Supabase secret for the `cornerman` Edge Function:
#   supabase secrets set GEMINI_API_KEY="..."
# Never prefix it with VITE_ (anything VITE_* is shipped to the browser).
GEMINI_API_KEY="your_server_side_gemini_api_key_here"

# 2. Supabase (optional — the app falls back to on-device storage automatically)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key"

# 3. n8n webhook (fires on B2B lead submit and Craving Reset check-ins)
VITE_N8N_WEBHOOK_URL="https://your-n8n-domain.com/webhook/ironclad-webhook"
